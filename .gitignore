# Track source and configuration only. Everything else is ignored by default.
*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements*.txt

!/src/
!/src/**/
!/src/**/*.py
!/src/**/*.json
!/src/**/*.yaml
!/src/**/*.yml
!/src/chatflow_agent/prompts/*.txt
!/src/psu_memory/pool/prompts/*.txt
!/src/psu_memory/retrieval/prompts/*.txt

!/configs/
!/configs/**/
!/configs/**/*.json
!/configs/**/*.yaml
!/configs/**/*.yml
!/configs/**/*.toml
!/configs/**/*.ini

!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.sh
!/scripts/**/*.ps1
!/scripts/**/*.sql

!/test/
!/test/**/
!/test/**/*.py

!/.vscode/
!/.vscode/launch.json
!/.vscode/settings.json

# Keep generated files and local credentials out of Git, even in source folders.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.DS_Store
.env
.env.*
*.pem
*.key
*.sqlite
*.sqlite3
*.db
*.log
*.safetensors
*.pt
*.pth
*.onnx
*.gguf
